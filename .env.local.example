# API Configuration
NEXT_PUBLIC_API_URL=https://apihack3r-production.up.railway.app
NEXT_PUBLIC_API_BASE_URL=https://apihack3r-production.up.railway.app
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_API_DOCS_URL=https://apihack3r-production.up.railway.app/docs/

# Development Configuration
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_DEV_MODE=false

# Feature Flags
NEXT_PUBLIC_ENABLE_ADMIN=true
NEXT_PUBLIC_ENABLE_REGISTRATION=false
NEXT_PUBLIC_ENABLE_DEBUG=false

# Authentication
NEXT_PUBLIC_AUTH_COOKIE_NAME=auth_token
NEXT_PUBLIC_AUTH_COOKIE_EXPIRES=7

# UI Configuration
NEXT_PUBLIC_SITE_NAME=H4ck3r L4bs
